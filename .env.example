# Copy to /etc/openbot/runtime.env. Keep mode 0600. Never commit the filled file.
OPENBOT_BIND_IP=127.0.0.1
POSTGRES_PASSWORD=
KEY_ENCRYPTION_KEY=
SUPERVISOR_TOKEN=
COMPUTER_TOKEN=
WORKER_SHARED_SECRET=
AGENT_TOOL_TOKEN=
MANAGED_AGENT_TOKEN=
BETTER_AUTH_SECRET=
INITIAL_ADMIN_EMAILS=
# Configure exactly one identity provider. See README.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT_ID=
OKTA_OAUTH_CLIENT_ID=
OKTA_OAUTH_CLIENT_SECRET=
OKTA_OAUTH_ISSUER=
SIGNIN_ALLOWED_EMAIL_DOMAINS=
INTELLIGENCE_API_URL=
INTELLIGENCE_GATEWAY_WS_URL=
CPK_INTELLIGENCE_API_KEY=
# Select openai, anthropic or google and fill the matching key.
BOT_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
BOT_MODEL=
# Set runsc only after installing and testing gVisor on the VM.
COMPUTER_RUNTIME=
