{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["github-actions", "custom.regex"],
  "pinDigests": true,
  "automerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^openbot-images\\.json$/"],
      "matchStrings": [
        "\"reference\":\\s*\"(?<depName>ghcr\\.io/copilotkit/openbot-[a-z-]+):(?<currentValue>v[0-9.]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images\\.env$/"],
      "matchStrings": [
        "POSTGRES_IMAGE=(?<depName>pgvector/pgvector):(?<currentValue>pg17)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^pg(?<major>17)$"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["/^ghcr\\.io/copilotkit/openbot-/"],
      "groupName": "OpenBot release",
      "changelogUrl": "https://github.com/CopilotKit/OpenBot/releases",
      "minimumReleaseAge": "1 day"
    }
  ]
}
