{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["github-actions", "docker-compose", "custom.regex"],
  "pinDigests": true,
  "automerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^compose\\.yaml$/"],
      "matchStrings": [
        "COMPUTER_IMAGE: (?<depName>ghcr\\.io/copilotkit/openbot-agent-computer):(?<currentValue>v[0-9.]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "pinDigests": false
    },
    {
      "matchPackageNames": ["/^ghcr\\.io/copilotkit/openbot-/"],
      "versioning": "semver-coerced",
      "allowedVersions": "/^v[0-9]+\\.[0-9]+\\.[0-9]+$/",
      "groupName": "OpenBot release",
      "changelogUrl": "https://github.com/CopilotKit/OpenBot/releases",
      "minimumReleaseAge": "1 day"
    },
    {
      "matchPackageNames": ["pgvector/pgvector"],
      "allowedVersions": "/^[0-9]+\\.[0-9]+\\.[0-9]+-pg17-bookworm$/"
    }
  ]
}
